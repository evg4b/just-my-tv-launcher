<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen (PLAN 11.4). M1: grid, focus ring, header. Video, poster, panels come later. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">
    <!-- no background: the poster or the video covers the screen (overdraw, PLAN 11.3) -->

    <!-- video wallpaper, under the poster (PLAN 6.2); gone unless the wallpaper is a video or the aerials -->
    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- the poster: the gradient, the picture, the video's first frame, or black before a video; opaque; fades out at
         the video's first frame. Its image is set in code (resetPoster), never the gradient under a video -->
    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@android:color/black" />

    <!-- dimming of a picture or video (0/20/40/60 %); its colour carries the alpha, so no extra layer -->
    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- only the top 20 % (108 of 540 dp): the gradient is clear below, so a full-screen view would only cost fill -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@drawable/scrim_top" />

    <!-- paddingTop is set in code to barTop (PLAN 7.2) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="0dp" />

    <!-- focus ring (PLAN 7.4): above the grid so the bar band does not cover it; not focusable.
         It is shifted while the grid scrolls, so neither it nor the root clips. -->
    <FrameLayout
        android:id="@+id/glass_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <!-- header on the left: greeting (off by default), clock and date, weather (M5) -->
    <LinearLayout
        android:id="@+id/header_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="56dp"
        android:layout_marginTop="26dp"
        android:orientation="vertical">

    <TextView
        android:id="@+id/greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.22"
        android:textAllCaps="true"
        android:textColor="#8CFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_light"
            android:fontFeatureSettings="tnum"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textColor="#FFFFFFFF"
            android:textSize="52sp" />

        <View
            android:id="@+id/date_divider"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#38FFFFFF" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_regular"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:letterSpacing="0.14"
            android:lineSpacingExtra="2dp"
            android:textAllCaps="true"
            android:textColor="#A6FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- weather under the clock (PLAN 4.7): icon, temperature, place; a dot and the time when the cache is old.
         The place and the time use the date's style (D96) -->
    <LinearLayout
        android:id="@+id/weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/wx_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/wx_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/outfit_medium"
            android:textColor="#F2FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/wx_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.14"
            android:maxWidth="320dp"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="#A6FFFFFF"
            android:textSize="14sp" />

        <View
            android:id="@+id/wx_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/status_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wx_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="#A6FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>

    <!-- header: round icons on the right, no labels (PLAN 7.1) -->
    <LinearLayout
        android:id="@+id/header_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="56dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_inputs"
            style="@style/RoundButton"
            android:contentDescription="@string/inputs"
            android:src="@drawable/ic_input" />

        <ImageButton
            android:id="@+id/btn_network"
            style="@style/RoundButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/network"
            android:src="@drawable/ic_wifi" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/RoundButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- under an open panel -->
    <View
        android:id="@+id/veil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <!-- settings and inputs panel (PLAN 10): 440 dp from the right; its content is built in code -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/panel_bg"
        android:visibility="gone" />
</FrameLayout>
