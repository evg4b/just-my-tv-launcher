<?xml version="1.0" encoding="utf-8"?>
<!-- The screensaver (SCREENSAVER 2): Home's wallpaper with the clock, the date and the weather. The ids match
     activity_main, so WallpaperController and HeaderBinder serve both. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- video and aerials, under the poster; gone otherwise -->
    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- the animated gradient, under a transparent poster; gone unless the wallpaper is a gradient -->
    <com.evg4b.justmytv.AmbientGradient
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- behind the text, so white reads over any picture -->
    <View
        android:id="@+id/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <!-- the clock block, bottom left; drifts a little every few minutes -->
    <LinearLayout
        android:id="@+id/clock_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="60dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_light"
            android:fontFeatureSettings="tnum"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:textColor="#FFFFFFFF"
            android:textSize="96sp" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit_regular"
            android:format12Hour="@string/date_format_line"
            android:format24Hour="@string/date_format_line"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wx_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/wx_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/outfit_medium"
                android:textColor="#F2F4F1EE"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/wx_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_regular"
                android:letterSpacing="0.14"
                android:maxWidth="360dp"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="#CCFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/photo_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="40dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_regular"
        android:maxWidth="360dp"
        android:singleLine="true"
        android:textColor="#8CFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
