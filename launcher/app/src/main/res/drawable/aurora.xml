<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora colours (PLAN 11.3), top-left to bottom-right: the default wallpaper and the window background.
     A shape, not a bitmap: a 1920x1080 bitmap would hold 8 MB for a gradient. Dithered against banding. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:dither="true"
    android:shape="rectangle">
    <gradient android:angle="315"
        android:startColor="#FF13547A"
        android:centerColor="#FF2B825B"
        android:endColor="#FF80D0C7" />
</shape>
