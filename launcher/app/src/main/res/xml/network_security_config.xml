<?xml version="1.0" encoding="utf-8"?>
<!-- Apple's aerial server chains to Apple Root CA, which Android 11 does not ship (RISKS 45). That root is trusted
     for this one host only, next to the system store; everything else keeps the platform defaults. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
