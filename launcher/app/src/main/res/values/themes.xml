<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Launcher" parent="android:Theme.Material.NoActionBar">
        <!-- the default wallpaper (PLAN 6.2); dropped after the first frame, when the poster view covers the window -->
        <item name="android:windowBackground">@drawable/aurora</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">#FF000000</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/round_btn</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
